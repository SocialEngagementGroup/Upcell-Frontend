
# Google Tag Manager container, e.g. GTM-XXXXXXX. Leave empty and nothing
# loads: no script tag, no requests, and every tracking call is a no-op.
VITE_GTM_ID=

# Card network logos on the checkout, the footer and the payment page.
# Off unless this is exactly "true". Showing a scheme mark is a claim UpCell
# can take that card - not one to make before the merchant agreement is
# confirmed. See PIPELINE.md, D13.
VITE_SHOW_CARD_BRANDS=false
